# Copy this file to .env and fill in your own values. .env is ignored by Git, never commit it.
DB_PASSWORD=change-me-db-password
DB_ROOT_PASSWORD=change-me-root-password
# Static IP of DC01 on the VMware NAT network
DC_IP=10.10.10.10
# Host's VMnet8 adapter IP. osTicket listens only here, so it's reachable from the lab, not from your home network.
LAB_HOST_IP=10.10.10.1
